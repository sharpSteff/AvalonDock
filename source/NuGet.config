<?xml version="1.0" encoding="utf-8"?>
<!-- Default: the public LibreWPF.Sdk preview from nuget.org (version pinned in
     global.json). To develop against a locally built ~/wpf LibreWPF instead, run
     eng/use-local-librewpf.sh (don't commit the swapped files). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
