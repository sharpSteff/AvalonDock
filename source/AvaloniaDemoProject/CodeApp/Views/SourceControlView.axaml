<UserControl
	x:Class="ToggleTestApp.Views.SourceControlView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="clr-namespace:ToggleTestApp.ViewModels"
	xmlns:views="clr-namespace:ToggleTestApp.Views"
	Background="{DynamicResource AppPanelBg}">
	<UserControl.Resources>
		<views:ChangeKindBrushConverter x:Key="ChangeKindBrushConverter" />

		<!--  Arc-like flat Expander theme  -->
		<ControlTheme x:Key="ArcExpander" TargetType="Expander">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{DynamicResource AppText}" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Template">
				<ControlTemplate>
					<DockPanel>
						<ToggleButton
							x:Name="HeaderBorder"
							Padding="6,4"
							HorizontalAlignment="Stretch"
							HorizontalContentAlignment="Stretch"
							Background="Transparent"
							BorderThickness="0"
							CornerRadius="0"
							Cursor="Hand"
							DockPanel.Dock="Top"
							IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}">
							<ToggleButton.Template>
								<ControlTemplate>
									<Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
										<ContentPresenter Content="{TemplateBinding Content}" />
									</Border>
								</ControlTemplate>
							</ToggleButton.Template>
							<Grid ColumnDefinitions="Auto,*">
								<Path
									x:Name="Arrow"
									Grid.Column="0"
									Margin="0,0,6,0"
									VerticalAlignment="Center"
									Data="M 0,0 L 4,4 L 0,8"
									Fill="Transparent"
									Stroke="{DynamicResource AppSubText}"
									StrokeThickness="1.5" />
								<ContentPresenter
									Grid.Column="1"
									VerticalAlignment="Center"
									Content="{TemplateBinding Header}" />
							</Grid>
						</ToggleButton>
						<ContentPresenter
							x:Name="ExpandContent"
							Content="{TemplateBinding Content}"
							DockPanel.Dock="Bottom"
							IsVisible="{TemplateBinding IsExpanded}" />
					</DockPanel>
				</ControlTemplate>
			</Setter>
			<Style Selector="^:expanded /template/ Path#Arrow">
				<Setter Property="RenderTransform" Value="rotate(90deg)" />
				<Setter Property="Fill" Value="{DynamicResource AppSubText}" />
			</Style>
			<Style Selector="^ /template/ ToggleButton#HeaderBorder:pointerover">
				<Setter Property="Background" Value="{DynamicResource AppInputBg}" />
			</Style>
		</ControlTheme>

		<!--  Clickable change item template  -->
		<DataTemplate x:Key="ChangeItemTemplate" DataType="vm:ChangeItem">
			<Border
				Margin="0"
				Padding="4,2"
				Classes="changeItem"
				Cursor="Hand"
				Tapped="OnChangeItemClick">
				<Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding FilePath}">
					<TextBlock
						Grid.Column="0"
						VerticalAlignment="Center"
						FontSize="12"
						Foreground="{DynamicResource AppText}"
						Text="{Binding FileName}"
						TextTrimming="CharacterEllipsis" />
					<TextBlock
						Grid.Column="1"
						Margin="6,0,4,0"
						VerticalAlignment="Center"
						FontSize="11"
						FontWeight="Bold"
						Foreground="{Binding Kind, Converter={StaticResource ChangeKindBrushConverter}}"
						Text="{Binding KindLabel}" />
				</Grid>
			</Border>
		</DataTemplate>
	</UserControl.Resources>
	<UserControl.Styles>
		<Style Selector="Border.changeItem">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="Border.changeItem:pointerover">
			<Setter Property="Background" Value="{DynamicResource AppInputBg}" />
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
		<!--  Branch info  -->
		<StackPanel
			Grid.Row="0"
			Margin="8,8,8,4"
			IsVisible="{Binding IsGitRepo}"
			Orientation="Horizontal">
			<TextBlock
				Margin="0,0,4,0"
				VerticalAlignment="Center"
				FontSize="13"
				Foreground="{DynamicResource AppSubText}"
				Text="⎇" />
			<TextBlock
				VerticalAlignment="Center"
				FontSize="12"
				Foreground="{DynamicResource AppText}"
				Text="{Binding BranchName}" />
		</StackPanel>

		<!--  Commit message  -->
		<Grid
			Grid.Row="1"
			Margin="8,4"
			ColumnDefinitions="*,Auto"
			IsVisible="{Binding IsGitRepo}">
			<TextBox
				Grid.Column="0"
				Padding="6,4"
				AcceptsReturn="False"
				Background="{DynamicResource AppInputBg}"
				BorderBrush="{DynamicResource AppDimText}"
				BorderThickness="1"
				CaretBrush="{DynamicResource AppText}"
				FontSize="12"
				Foreground="{DynamicResource AppText}"
				MaxLines="1"
				Text="{Binding CommitMessage}" />
			<Button
				Grid.Column="1"
				Margin="4,0,0,0"
				Padding="8,4"
				Background="Transparent"
				BorderThickness="0"
				Command="{Binding CommitCommand}"
				Content="✓"
				Cursor="Hand"
				FontSize="14"
				FontWeight="Bold"
				Foreground="{DynamicResource AppText}"
				ToolTip.Tip="Commit" />
		</Grid>

		<!--  Staged changes  -->
		<Expander
			Grid.Row="2"
			Margin="0,4,0,0"
			IsExpanded="True"
			IsVisible="{Binding IsGitRepo}"
			Theme="{StaticResource ArcExpander}">
			<Expander.Header>
				<StackPanel Orientation="Horizontal">
					<TextBlock
						VerticalAlignment="Center"
						FontSize="10"
						FontWeight="Bold"
						Foreground="{DynamicResource AppSubText}"
						Text="STAGED CHANGES" />
					<TextBlock
						VerticalAlignment="Center"
						FontSize="10"
						Foreground="{DynamicResource AppDimText}"
						Text="{Binding StagedChanges.Count, StringFormat=' ({0})'}" />
				</StackPanel>
			</Expander.Header>
			<ItemsControl
				Margin="16,0,0,0"
				ItemTemplate="{StaticResource ChangeItemTemplate}"
				ItemsSource="{Binding StagedChanges}" />
		</Expander>

		<!--  Unstaged changes  -->
		<Expander
			Grid.Row="3"
			Margin="0,4,0,0"
			IsExpanded="True"
			IsVisible="{Binding IsGitRepo}"
			Theme="{StaticResource ArcExpander}">
			<Expander.Header>
				<StackPanel Orientation="Horizontal">
					<TextBlock
						VerticalAlignment="Center"
						FontSize="10"
						FontWeight="Bold"
						Foreground="{DynamicResource AppSubText}"
						Text="CHANGES" />
					<TextBlock
						VerticalAlignment="Center"
						FontSize="10"
						Foreground="{DynamicResource AppDimText}"
						Text="{Binding UnstagedChanges.Count, StringFormat=' ({0})'}" />
				</StackPanel>
			</Expander.Header>
			<ItemsControl
				Margin="16,0,0,0"
				ItemTemplate="{StaticResource ChangeItemTemplate}"
				ItemsSource="{Binding UnstagedChanges}" />
		</Expander>

		<!--  No git message  -->
		<TextBlock
			Grid.Row="4"
			Margin="12"
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			FontSize="12"
			Foreground="{DynamicResource AppSubText}"
			IsVisible="{Binding !IsGitRepo}"
			Text="{Binding Status}" />

		<!--  Refresh button  -->
		<Border Grid.Row="5" Padding="8,4" Background="{DynamicResource AppInputBarBg}">
			<Grid>
				<TextBlock
					VerticalAlignment="Center"
					FontSize="11"
					Foreground="{DynamicResource AppSubText}"
					Text="{Binding Status}" />
				<Button
					Padding="6,2"
					HorizontalAlignment="Right"
					Background="Transparent"
					BorderThickness="0"
					Command="{Binding RefreshCommand}"
					Content="↻"
					Cursor="Hand"
					FontSize="13"
					Foreground="{DynamicResource AppSubText}"
					ToolTip.Tip="Refresh" />
			</Grid>
		</Border>
	</Grid>
</UserControl>
