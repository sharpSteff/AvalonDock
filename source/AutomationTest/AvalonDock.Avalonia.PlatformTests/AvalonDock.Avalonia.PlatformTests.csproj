<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Runs docking scenarios against the real windowing backend of the OS it runs on (Win32, macOS, X11),
		unlike AvalonDock.Avalonia.Tests, which uses Avalonia.Headless. It is a console program rather than a
		test project because macOS only allows UI on the main thread of the process, which a test runner
		does not offer. Exit code 0 means every scenario passed.
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>disable</Nullable>
		<IsPackable>false</IsPackable>
		<RunAnalyzers>false</RunAnalyzers>
		<EnableNETAnalyzers>false</EnableNETAnalyzers>
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>..\..\Components\AvalonDock\sn.snk</AssemblyOriginatorKeyFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Components\AvalonDock.Avalonia\AvalonDock.Avalonia.csproj" />
	</ItemGroup>

</Project>
