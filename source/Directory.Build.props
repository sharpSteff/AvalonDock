<Project>
	<PropertyGroup>
		<!-- TFM of the LibreWPF (ProGPU/Silk.NET) portable leg. Defaults to net10.0-windows,
		     matching the public LibreWPF.Sdk preview from nuget.org (pinned in global.json).
		     When developing against a locally built ~/wpf LibreWPF (eng/use-local-librewpf.sh),
		     override with -p:LibreWpfTargetFramework=net11.0-windows. -->
		<LibreWpfTargetFramework Condition="'$(LibreWpfTargetFramework)' == ''">net10.0-windows</LibreWpfTargetFramework>
		<!-- Centralized Target Frameworks -->
		<ComponentTargetFrameworks>net9.0-windows;net10.0-windows;net48</ComponentTargetFrameworks>
		<TestTargetFrameworks>net9.0-windows;net10.0-windows;net48</TestTargetFrameworks>
		<!-- On non-Windows hosts only the LibreWPF (ProGPU/Silk.NET) leg can build and run -->
		<ComponentTargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('Windows'))">$(LibreWpfTargetFramework)</ComponentTargetFrameworks>
		<TestTargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('Windows'))">$(LibreWpfTargetFramework)</TestTargetFrameworks>
		<LangVersion>13</LangVersion>

		<!-- Version Information -->
		<VersionPrefix>5.0.0</VersionPrefix>
		<AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
		<FileVersion>$(VersionPrefix).0</FileVersion>
		<Company>Open Source</Company>
		<Product>Dirkster.AvalonDock</Product>
		<Copyright>2017-2026</Copyright>
		<Description>This assembly implements a docking layout system for WPF.</Description>
		<PackageProjectUrl>https://github.com/Dirkster99/AvalonDock</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Dirkster99/AvalonDock</RepositoryUrl>
		<Authors>https://github.com/Dirkster99/AvalonDock</Authors>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageTags>WPF avalondock docking layout MVVM</PackageTags>

		<!-- Single source of truth for the license shipped in every NuGet package -->
		<PackageLicenseSourceFile>$(MSBuildThisFileDirectory)..\LICENSE</PackageLicenseSourceFile>

		<!-- Enforce zero warnings policy -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>
	<!--
		LibreWPF: WPF components use Sdk="LibreWPF.Sdk" so the $(LibreWpfTargetFramework) leg runs
		on the portable ProGPU/Silk.NET platform on non-Windows hosts. On Windows hosts, and for
		every other target framework, the LibreWPF SDK must behave exactly like
		Microsoft.NET.Sdk.WindowsDesktop (the net10.0-windows leg there is classic WPF), so its
		portable mode is switched off.
		(This file is imported after the LibreWPF Sdk.props defaults, so plain assignments win.)
	-->
	<PropertyGroup Condition="'$(_ProGpuWpfSdkImported)' == 'true' And '$(TargetFramework)' != '' And ($([MSBuild]::IsOSPlatform('Windows')) Or '$(TargetFramework)' != '$(LibreWpfTargetFramework)')">
		<ProGpuWpfUsePortableFrameworkReferences>false</ProGpuWpfUsePortableFrameworkReferences>
		<ProGpuWpfUsePortablePlatform>false</ProGpuWpfUsePortablePlatform>
		<ProGpuWpfEnablePortableBootstrap>false</ProGpuWpfEnablePortableBootstrap>
		<ProGpuWpfEnableWin32CompatShim>false</ProGpuWpfEnableWin32CompatShim>
		<ProGpuWpfUseCurrentRuntimeIdentifier>false</ProGpuWpfUseCurrentRuntimeIdentifier>
		<RuntimeIdentifier></RuntimeIdentifier>
		<UseWPF>true</UseWPF>
	</PropertyGroup>
	<ItemGroup>
		<!-- Pack the shared root LICENSE into every package without copying it per project -->
		<None Include="$(PackageLicenseSourceFile)" Pack="true" PackagePath="" Visible="false" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers"
			Version="10.*">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers;
				buildtransitive
			</IncludeAssets>
		</PackageReference>
		<PackageReference Include="SonarAnalyzer.CSharp" Version="10.*">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
		<AdditionalFiles Include="$(MSBuildThisFileDirectory)CodeMetricsConfig.txt"
			Condition="Exists('$(MSBuildThisFileDirectory)CodeMetricsConfig.txt')" />
		<PackageReference Include="Microsoft.CodeAnalysis.Metrics" Version="4.14.0">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>
	<Choose>
		<When
			Condition="'$(MSBuildProjectName.Contains(`Test`))' == 'false'">
			<ItemGroup>
				<!--        Enable to active stylecop for the whole solution-->
				<PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
					<PrivateAssets>all</PrivateAssets>
					<IncludeAssets>runtime; build; native; contentfiles; analyzers;
						buildtransitive
					</IncludeAssets>
				</PackageReference>
			</ItemGroup>
		</When>
	</Choose>
</Project>
