<Project>
	<!-- Avalonia build of AvalonDockCodeApp. It compiles the sources of this folder - the same files
	     as AvalonDockCodeApp.csproj - with AVALONIA defined, like AvalonDock.Avalonia.csproj does for
	     the library:
	       - the markup is Name.axaml next to Name.xaml;
	       - small differences in the code sit behind #if AVALONIA in the shared file;
	       - Avalonia-only code lives in Name.Avalonia.cs (AvalonDockCodeApp.csproj skips those
	         files); where such a file replaces a WPF file, the WPF file is removed below. -->

	<!-- Both projects live in this folder, so this one keeps its intermediate and output files apart.
	     These must be set before the SDK props are imported. -->
	<PropertyGroup>
		<BaseIntermediateOutputPath>obj\Avalonia\</BaseIntermediateOutputPath>
		<BaseOutputPath>bin\Avalonia\</BaseOutputPath>
	</PropertyGroup>
	<Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>ToggleTestApp</RootNamespace>
		<AssemblyName>AvalonDockCodeApp.Avalonia</AssemblyName>
		<IsPackable>false</IsPackable>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
		<DefineConstants>$(DefineConstants);AVALONIA</DefineConstants>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<!-- AVLN3001: the main window is created through dependency injection, so it has no
		     parameterless constructor for the runtime XAML loader, which this app never uses for it. -->
		<NoWarn>$(NoWarn);AVLN3001</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
		<PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Components\AvalonDock\AvalonDock.Avalonia.csproj" />
		<ProjectReference Include="..\Components\AvalonDock.Core\AvalonDock.Core.csproj" />
		<ProjectReference Include="..\Components\AvalonDock.Mvvm\AvalonDock.Mvvm.csproj" />
		<ProjectReference Include="..\Components\AvalonDock.Mvvm.CommunityToolkit\AvalonDock.Mvvm.CommunityToolkit.csproj" />
		<ProjectReference Include="..\Components\AvalonDock.DependencyInjection\AvalonDock.DependencyInjection.csproj" />
		<ProjectReference Include="..\Components\AvalonDock.Serializer.Xml\AvalonDock.Serializer.Xml.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- The WPF build's intermediate and output files. -->
		<Compile Remove="obj\**;bin\**" />
		<AvaloniaXaml Remove="obj\**;bin\**" />
		<EmbeddedResource Remove="obj\**;bin\**" />
		<None Remove="obj\**;bin\**" />

		<!-- Replaced by their Name.Avalonia.cs implementations: the icons are drawn as geometries
		     rather than with the Segoe glyphs and WPF imaging of the WPF application. -->
		<Compile Remove="ViewModels\FileIconHelper.cs;ViewModels\ToolboxIcons.cs" />
	</ItemGroup>

	<Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
