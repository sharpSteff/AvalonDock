<Project>

	<!--
		LibreWPF: NuGet packages built for classic WPF (e.g. AvalonEdit) declare a transitive
		FrameworkReference on Microsoft.WindowsDesktop.App. Those arrive via the assets file at
		build time, after LibreWPF.Sdk's static Remove, and would demand the WindowsDesktop
		targeting pack. In portable (ProGPU) mode the LibreWPF transport assemblies replace that
		framework, so drop the transitive references before targeting-pack resolution runs.
	-->
	<Target Name="_LibreWpfRemoveTransitiveWindowsDesktopFrameworkReferences"
	        AfterTargets="AddTransitiveFrameworkReferences"
	        BeforeTargets="ResolveFrameworkReferences"
	        Condition="'$(ProGpuWpfUsePortableFrameworkReferences)' == 'true'">
		<ItemGroup>
			<FrameworkReference Remove="Microsoft.WindowsDesktop.App" />
			<FrameworkReference Remove="Microsoft.WindowsDesktop.App.WPF" />
			<FrameworkReference Remove="Microsoft.WindowsDesktop.App.WindowsForms" />
		</ItemGroup>
	</Target>

</Project>
