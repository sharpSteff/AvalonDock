<Project Sdk="Microsoft.NET.Sdk">
	<!-- Avalonia port of the WPF AvalonDock library: DockingManager, ToggleDockingManager and the
	     layout model, built on Avalonia so it runs on Windows, Linux and macOS without a WPF
	     implementation underneath. It shares AvalonDock.Core (and with it the Mvvm, DI and
	     serializer packages) with the WPF library; the layout model and controls are ported copies,
	     kept in the same namespaces so code written against the WPF package moves over with few
	     changes. -->
	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<RootNamespace>AvalonDock</RootNamespace>
		<AssemblyName>AvalonDock.Avalonia</AssemblyName>
		<PackageId>Dirkster.AvalonDock.Avalonia</PackageId>
		<Description>This assembly implements a docking layout system for Avalonia (DockingManager and ToggleDockingManager).</Description>
		<PackageTags>Avalonia avalondock docking layout MVVM</PackageTags>
		<LangVersion>latest</LangVersion>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>..\AvalonDock\sn.snk</AssemblyOriginatorKeyFile>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
		<!-- Same opt-out as the WPF library: the ported code keeps upstream's conventions, which the
		     StyleCop/Sonar gates of Directory.Build.props were never applied to. Compiler warnings
		     still fail the build. -->
		<RunAnalyzers>false</RunAnalyzers>
		<EnableNETAnalyzers>false</EnableNETAnalyzers>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AvalonDock.Core\AvalonDock.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<AvaloniaResource Include="Themes\**\*.png;Themes\**\*.PNG" />
	</ItemGroup>
</Project>
