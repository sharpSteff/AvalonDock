<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- LibreWPF 11.0.0-dev packages are mutable; keep them out of the shared global cache -->
    <add key="globalPackagesFolder" value="../.librewpf-nuget" />
  </config>
  <packageSources>
    <clear />
    <!-- Locally built LibreWPF/ProGPU preview feed (built via ~/wpf/eng/progpu-wpf-sdk-ci.sh) -->
    <add key="LibreWPFLocalArtifacts" value="../../wpf/artifacts/packages/Release/NonShipping" />
    <add key="dotnet11" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet11/nuget/v3/index.json" />
    <add key="dotnet11-transport" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet11-transport/nuget/v3/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
